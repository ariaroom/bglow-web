# Copy to .env for local dev. NEVER commit the real .env file.
# In production these are set in Vercel > Project > Settings > Environment Variables.

# Stripe (Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe (Dashboard > Developers > Webhooks > your endpoint > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase (Project Settings > API Keys)
SUPABASE_URL=https://xxxx.supabase.co
# Use the SECRET key (server-only, bypasses RLS) - NOT the publishable key.
# New projects: sb_secret_...   Legacy projects: the `service_role` JWT (eyJ...)
SUPABASE_SECRET_KEY=sb_secret_xxx

# OPTIONAL — Sales tax. Leave unset to charge no tax (current default).
# Set to a Stripe TaxRate id (exclusive) only after confirming taxability
# AND registering as a NY sales tax vendor. See DEPLOYMENT.md 3b.
# STRIPE_TAX_RATE_ID=txr_xxx

# Public site URL (used to build Stripe success/cancel URLs)
# SITE_URL=https://bglow-web.vercel.app   # optional; auto-detected
